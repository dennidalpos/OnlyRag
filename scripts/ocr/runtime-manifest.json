{
  "strategy": "per-user-online-venv",
  "installRoot": "%LOCALAPPDATA%\\OnlyRag\\ocr-python",
  "pythonMinimumVersion": "3.10.0",
  "pythonMaximumVersion": "3.13.x",
  "minimumFreeDiskBytes": 5368709120,
  "runtimeTargets": [
    {
      "target": "cpu",
      "requirementsFile": "requirements-cpu.txt",
      "resolvedRuntime": "cpu",
      "paddlePackage": "paddlepaddle",
      "paddleVersion": "3.3.1"
    },
    {
      "target": "nvidia",
      "requirementsFile": "requirements-nvidia-cu129.txt",
      "resolvedRuntime": "cuda129",
      "paddlePackage": "paddlepaddle-gpu",
      "paddleVersion": "3.3.0",
      "cudnnPackage": "nvidia-cudnn-cu12",
      "cudnnVersion": "9.9.0.52",
      "minimumWindowsDriver": "576.02"
    },
    {
      "target": "nvidia",
      "requirementsFile": "requirements-nvidia-cu126.txt",
      "resolvedRuntime": "cuda126",
      "paddlePackage": "paddlepaddle-gpu",
      "paddleVersion": "3.3.0",
      "minimumWindowsDriver": "560.94"
    },
    {
      "target": "nvidia",
      "requirementsFile": "requirements-nvidia-cu118.txt",
      "resolvedRuntime": "cuda118",
      "paddlePackage": "paddlepaddle-gpu",
      "paddleVersion": "3.3.0",
      "minimumWindowsDriver": "520.06"
    }
  ],
  "modelCacheLocations": [
    "%USERPROFILE%\\.paddlex",
    "%USERPROFILE%\\.paddleocr"
  ],
  "packages": [
    {
      "name": "paddleocr",
      "version": "3.5.0",
      "importName": "paddleocr"
    },
    {
      "name": "paddlepaddle",
      "version": "3.3.1",
      "importName": "paddle"
    },
    {
      "name": "pillow",
      "version": "12.2.0",
      "importName": "PIL"
    },
    {
      "name": "pypdfium2",
      "version": "5.8.0",
      "importName": "pypdfium2"
    },
    {
      "name": "opencv-python",
      "version": "4.13.0.92",
      "importName": "cv2"
    }
  ]
}
