<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OnlyRag.Core\OnlyRag.Core.csproj" />
    <ProjectReference Include="..\OnlyRag.Worker\OnlyRag.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\scripts\ocr\**\*" Exclude="..\..\scripts\ocr\**\__pycache__\**;..\..\scripts\ocr\**\*.pyc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>scripts\ocr\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="$(NuGetPackageRoot)sqlite-vec\0.1.7-alpha.2.1\runtimes\win-x64\native\vec0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>vec0.dll</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
