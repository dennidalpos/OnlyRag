<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OnlyRag.Core\OnlyRag.Core.csproj" />
    <ProjectReference Include="..\OnlyRag.Infrastructure\OnlyRag.Infrastructure.csproj" />
    <ProjectReference Include="..\OnlyRag.Api\OnlyRag.Api.csproj" />
    <ProjectReference Include="..\OnlyRag.Worker\OnlyRag.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\OnlyRag.ico" />
    <Resource Include="Assets\OnlyRag.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\OnlyRag.Web\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\packaging\qdrant\payload\**\*">
      <Link>qdrant\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\OnlyRag.ico</ApplicationIcon>
    <Product>OnlyRag</Product>
    <Company>OnlyRag</Company>
    <Authors>OnlyRag</Authors>
    <Description>Local-first document RAG for Windows.</Description>
    <RepositoryUrl>https://github.com/dennidalpos/OnlyRag</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dennidalpos/OnlyRag</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 OnlyRag</Copyright>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
