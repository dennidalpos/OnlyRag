<Window x:Class="OnlyRag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OnlyRag"
        Height="720"
        Width="1120"
        MinHeight="560"
        MinWidth="900"
        Icon="Assets/OnlyRag.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Background="#F5F7FA">
        <wv2:WebView2 x:Name="MainWebView" />

        <Border x:Name="StartupErrorPanel"
                Visibility="Collapsed"
                MaxWidth="560"
                Padding="28"
                BorderBrush="#D5DBE5"
                BorderThickness="1"
                Background="#FFFFFF"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="StartupErrorTitle"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StartupErrorMessage"
                           Margin="0,12,0,0"
                           FontSize="14"
                           LineHeight="21"
                           Foreground="#4A5568"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
