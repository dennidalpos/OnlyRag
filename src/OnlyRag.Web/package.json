{
  "name": "onlyrag-web",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first document RAG for the OnlyRag Windows desktop WebView shell.",
  "homepage": "https://github.com/dennidalpos/OnlyRag",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write eslint.config.js .prettierrc.json package.json playwright.config.ts scripts/check-format.mjs",
    "format:check": "prettier --check eslint.config.js .prettierrc.json package.json playwright.config.ts scripts/check-format.mjs && node scripts/check-format.mjs",
    "openapi:generate": "openapi-ts -i http://127.0.0.1:5000/openapi/v1.json -o src/api/generated",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
